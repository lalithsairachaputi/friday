# Friday voice assistant — placeholders only. Never commit real secrets.

# Application
FRIDAY_JWT_SECRET=replace-with-a-long-random-secret
FRIDAY_ENV=development
FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8080
FRIDAY_PUBLIC_URL=http://localhost:8080
FRIDAY_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRIDAY_DATABASE_PATH=./data/friday.db

# LiveKit (server-side only)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=friday-voice

# Rime (PRIMARY TTS — server-side only)
RIME_API_KEY=your_rime_api_key
RIME_WS_URL=wss://users-ws.rime.ai
RIME_HTTP_URL=https://users.rime.ai/v1/rime-tts

# LLM / STT
OPENAI_API_KEY=your_openai_api_key
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# Optional web search (DuckDuckGo works without a key)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_API_KEY=

# Fallback TTS for languages Rime does not currently serve (Telugu, Tamil)
# edge = Microsoft Edge TTS (local client). Never reported as Rime.
FALLBACK_TTS_PROVIDER=edge

# Stress / reproducible test delays (milliseconds). 0 = off.
# When any of these is non-zero, stress mode is documented in /health and metrics.
TOOL_DELAY_MS=0
WEB_SEARCH_DELAY_MS=0
WEB_PAGE_DELAY_MS=0
LLM_DELAY_MS=0
TTS_DELAY_MS=0
INTERRUPTION_DELAY_MS=0
